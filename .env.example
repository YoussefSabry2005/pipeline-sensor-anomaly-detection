# Optional settings for `docker compose` and local runs. Copy to `.env` to change them.
# There are no secrets in this project: everything runs locally on simulated data.

# Producer
STREAM_RATE=40          # messages per wall-clock second (each message = one 5-minute reading)
STREAM_DAYS=30          # simulated days per period before a new period starts
STREAM_SEED=2026        # must differ from the training seed (42)
FAULT_RATE=0.01         # share of messages deliberately corrupted to exercise error handling

# Processor
STREAM_DETECTORS=Isolation Forest,Local Outlier Factor
MAX_BATCH=64            # largest micro-batch scored in one call
LOG_LEVEL=INFO          # DEBUG also logs every incoming observation

# Dashboard
DASHBOARD_PORT=8501
